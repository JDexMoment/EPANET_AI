# ── доступ ────────────────────────────────────────────────────────────────
# Токен администратора (вы). Сгенерируйте:  openssl rand -hex 16
ADMIN_TOKEN=замените_на_свой_длинный_токен

# Токены инженеров: ТОКЕН:ИМЯ:РОЛЬ через запятую (роль: expert | lead)
EXPERT_TOKENS=токен1:Иван Петров:lead,токен2:Мария Сидорова:expert

# ── адрес ─────────────────────────────────────────────────────────────────
# Домен для TLS (Caddy получит сертификат автоматически). Без домена оставьте ":80".
SITE_ADDRESS=:80
# Публичный адрес сервиса (без слэша на конце) — из него собираются персональные
# ссылки для инженеров в админке. Пример: https://epanet.example.com
SERVICE_PUBLIC_URL=

# ── пределы ───────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=60
MAX_ANNOTATIONS_PER_HOUR=60
MAX_UPLOADS_PER_DAY=40

# ── автономность ──────────────────────────────────────────────────────────
# Как часто сам собирать архив для обучения (часы; 0 — выключить)
AUTO_EXPORT_HOURS=6
# Сколько архивов хранить
KEEP_EXPORTS=30
# Куда дополнительно копировать каждый архив (rclone/curl/scp). {file} подставляется:
# BACKUP_CMD=rclone copy {file} yandex:epanet-ai-backup
BACKUP_CMD=
# Уведомление в Telegram-бот (webhook): "Просто пришлите сообщение после экспорта"
ANNOUNCE_WEBHOOK=

# ── расчёт ────────────────────────────────────────────────────────────────
RUN_SIMULATION=1
CONTEXT_MODES=whats_happening,explain_object,find_problems,why_happened,make_report
